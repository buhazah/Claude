# --- Model access (required) ---
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model for all agents.
# COMPANY_MODEL=claude-sonnet-4-6

# Which store config to load (defaults to config/store.yaml).
# STORE_CONFIG=config/store.yaml

# --- Shopify MCP (required for the Store agent) ---
# The agent company talks to the LOCAL Shopify MCP server (mcp_server/).
# Start that server (see mcp_server/README.md), then point the company at it:
SHOPIFY_MCP_URL=http://localhost:8000/mcp
SHOPIFY_MCP_TOKEN=                       # leave blank: the local server holds the creds

# --- Local Shopify MCP server creds (used by mcp_server/shopify_mcp.py) ---
# These stay on your machine. The Admin token never goes to the model.
SHOPIFY_STORE_DOMAIN=cvqpju-j0.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_...            # the token you mint in Shopify admin
SHOPIFY_API_VERSION=2025-01

# --- Product research MCP (optional: Product Scout) ---
# e.g. WinningHunter or any ad-research MCP server.
RESEARCH_MCP_URL=
RESEARCH_MCP_TOKEN=

# --- Ad platform MCP (optional: future Ads Buyer agent) ---
META_MCP_URL=
META_MCP_TOKEN=
