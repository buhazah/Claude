# systemd unit: keeps the docker-compose stack running 24/7 and restarts it on
# boot or failure. Install on a VPS that has Docker + the compose plugin.
#
#   sudo cp deploy/agent-company.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agent-company
#
# Check it:    systemctl status agent-company
# Live logs:   journalctl -u agent-company -f   (or: docker compose logs -f)
# Restart:     sudo systemctl restart agent-company
#
# Edit WorkingDirectory below to wherever you cloned the repo.

[Unit]
Description=Shopify Agent Company (autopilot + MCP server)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/shopify-agent-company
# Build is a no-op after the first run unless the code changed.
ExecStartPre=/usr/bin/docker compose build
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
