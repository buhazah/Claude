# ============================================================================
# JARVIS environment configuration. Copy to .env and fill in.
# Everything has a safe default; set at least ONE LLM provider key to enable
# reasoning. See docs/ENVIRONMENT.md for the full reference.
# ============================================================================

# ---- Core -------------------------------------------------------------------
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8700
JARVIS_DEBUG=false
# Persist sessions/keys across restarts. Generate: openssl rand -base64 48
# JARVIS_SECRET_KEY=

# ---- Database ---------------------------------------------------------------
# SQLite by default (zero config). For production, use Postgres:
# JARVIS_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/jarvis
# JARVIS_DATA_DIR=./data

# ---- Security ---------------------------------------------------------------
JARVIS_ACCESS_TOKEN_MINUTES=60
JARVIS_REFRESH_TOKEN_DAYS=30
JARVIS_ALLOW_REGISTRATION=true
JARVIS_RATE_LIMIT_PER_MINUTE=120
# Comma-separated allowed origins; empty allows all (dev only).
# JARVIS_CORS_ORIGINS=https://app.example.com

# ---- Sandbox (filesystem / shell / code tools) ------------------------------
JARVIS_ENABLE_SHELL_TOOL=true
JARVIS_SHELL_TIMEOUT=30
# JARVIS_SANDBOX_DIR=./data/sandbox

# ---- LLM providers (set at least one) ---------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Local models via Ollama, e.g. http://localhost:11434
OLLAMA_BASE_URL=

# ---- Embeddings -------------------------------------------------------------
# auto | openai | voyage | local  (local needs no key and works offline)
JARVIS_EMBEDDING_PROVIDER=auto
VOYAGE_API_KEY=

# ---- Voice (ElevenLabs) -----------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ---- Web search -------------------------------------------------------------
# duckduckgo (no key) | brave
JARVIS_SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=

# ---- Memory tuning ----------------------------------------------------------
JARVIS_MEMORY_HALF_LIFE_DAYS=30
JARVIS_MEMORY_CONSOLIDATION_THRESHOLD=50
JARVIS_MEMORY_MAX_RETRIEVAL=12
